<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VisualForge.UI.Xaml.View.Control.SolutionExplorerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <TreeView
        x:Name="WorkspaceTree"
        Margin="6"
        SelectionChanged="WorkspaceTree_SelectionChanged">
        <TreeView.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Open" Click="ContextOpen_Click" />
                <MenuFlyoutItem Text="Properties" Click="ContextProperties_Click" />
                <MenuFlyoutItem Text="Set as Startup Project" Click="ContextStartup_Click" />
                <MenuFlyoutItem Text="Add New Item" Click="ContextAddItem_Click" />
                <MenuFlyoutItem Text="Add Existing Item" Click="ContextAddExistingItem_Click" />
                <MenuFlyoutItem Text="Remove From Project" Click="ContextRemoveFromProject_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Refresh" Click="ContextRefresh_Click" />
            </MenuFlyout>
        </TreeView.ContextFlyout>
    </TreeView>
</UserControl>
