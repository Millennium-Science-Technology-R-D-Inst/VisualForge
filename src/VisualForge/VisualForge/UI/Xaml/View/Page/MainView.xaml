                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,7,0"
                            Style="{StaticResource VFDockGlyphTextBlockStyle}"
                            Text="&#xE700;" />
