<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VisualForge.UI.Xaml.View.Page.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VisualForge.UI.Xaml.View.Page"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="VisualForgeChromeBrush" Color="#202328" />
        <SolidColorBrush x:Key="VisualForgePanelBrush" Color="#272B31" />
        <SolidColorBrush x:Key="VisualForgeInsetBrush" Color="#1B1E23" />
        <SolidColorBrush x:Key="VisualForgeBorderBrush" Color="#3B414A" />
        <SolidColorBrush x:Key="VisualForgeAccentBrush" Color="#3BAFDA" />
        <SolidColorBrush x:Key="VisualForgeSuccessBrush" Color="#56A85E" />
        <SolidColorBrush x:Key="VisualForgeWarningBrush" Color="#D9A441" />
    </Page.Resources>

    <Grid Background="{StaticResource VisualForgeInsetBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            MinHeight="46"
            Padding="12,6"
            Background="{StaticResource VisualForgeChromeBrush}"
            BorderBrush="{StaticResource VisualForgeBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    FontSize="18"
                    Foreground="{StaticResource VisualForgeAccentBrush}"
                    Glyph="&#xE943;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="VisualForge" />
            </StackPanel>

            <CommandBar
                Grid.Column="1"
                Margin="24,0,0,0"
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsOpen="False">
                <AppBarButton Label="Open" ToolTipService.ToolTip="Open workspace">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Build" ToolTipService.ToolTip="Build selected project">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Run" ToolTipService.ToolTip="Start debugging">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Git" ToolTipService.ToolTip="Refresh Git status">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Packages" ToolTipService.ToolTip="Restore packages">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Padding="8,4"
                    Background="{StaticResource VisualForgeInsetBrush}"
                    BorderBrush="{StaticResource VisualForgeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{StaticResource VisualForgeSuccessBrush}" />
                        <TextBlock FontSize="12" Text="Debug | x64" />
                    </StackPanel>
                </Border>
                <Button Padding="8,4" ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="340" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource VisualForgePanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="10,8"
                    BorderBrush="{StaticResource VisualForgeBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Project" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button Padding="6,3" ToolTipService.ToolTip="Refresh project">
                            <FontIcon FontSize="13" Glyph="&#xE72C;" />
                        </Button>
                        <Button Padding="6,3" ToolTipService.ToolTip="Collapse all">
                            <FontIcon FontSize="13" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TreeView
                    Grid.Row="1"
                    Margin="4,6"
                    SelectionMode="Single">
                    <TreeView.RootNodes>
                        <TreeViewNode Content="VisualForge" IsExpanded="True">
                            <TreeViewNode.Children>
                                <TreeViewNode Content="IDE Layer" IsExpanded="True">
                                    <TreeViewNode.Children>
                                        <TreeViewNode Content="WinUI" />
                                        <TreeViewNode Content="Editor" />
                                        <TreeViewNode Content="Project Explorer" />
                                        <TreeViewNode Content="Git UI" />
                                        <TreeViewNode Content="Debug UI" />
                                        <TreeViewNode Content="Package UI" />
                                    </TreeViewNode.Children>
                                </TreeViewNode>
                                <TreeViewNode Content="Integration Layer" IsExpanded="True">
                                    <TreeViewNode.Children>
                                        <TreeViewNode Content="ClangdAdapter" />
                                        <TreeViewNode Content="GitAdapter" />
                                        <TreeViewNode Content="MSBuildAdapter" />
                                        <TreeViewNode Content="VcpkgAdapter" />
                                        <TreeViewNode Content="NuGetAdapter" />
                                        <TreeViewNode Content="DebugAdapter" />
                                    </TreeViewNode.Children>
                                </TreeViewNode>
                                <TreeViewNode Content="Tool Layer" IsExpanded="True">
                                    <TreeViewNode.Children>
                                        <TreeViewNode Content="clangd" />
                                        <TreeViewNode Content="git" />
                                        <TreeViewNode Content="msbuild" />
                                        <TreeViewNode Content="cl.exe" />
                                        <TreeViewNode Content="vcpkg" />
                                        <TreeViewNode Content="nuget" />
                                        <TreeViewNode Content="lldb-dap" />
                                    </TreeViewNode.Children>
                                </TreeViewNode>
                            </TreeViewNode.Children>
                        </TreeViewNode>
                    </TreeView.RootNodes>
                </TreeView>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource VisualForgeBorderBrush}" />

            <Grid Grid.Column="2" Background="{StaticResource VisualForgeInsetBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="170" />
                </Grid.RowDefinitions>

                <TabView
                    Grid.Row="0"
                    IsAddTabButtonVisible="False"
                    TabWidthMode="SizeToContent">
                    <TabViewItem Header="MainView.xaml">
                        <Grid Background="{StaticResource VisualForgeInsetBrush}">
                            <TextBox
                                Padding="16"
                                AcceptsReturn="True"
                                Background="{StaticResource VisualForgeInsetBrush}"
                                BorderThickness="0"
                                FontFamily="Cascadia Mono"
                                FontSize="13"
                                Text="&lt;Page x:Class=&quot;VisualForge.UI.Xaml.View.Page.MainView&quot;&gt;&#x0a;    &lt;Grid&gt;&#x0a;        &lt;!-- Editor buffer surface placeholder --&gt;&#x0a;    &lt;/Grid&gt;&#x0a;&lt;/Page&gt;"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="MSBuildAdapter.cpp">
                        <Grid Background="{StaticResource VisualForgeInsetBrush}">
                            <TextBox
                                Padding="16"
                                AcceptsReturn="True"
                                Background="{StaticResource VisualForgeInsetBrush}"
                                BorderThickness="0"
                                FontFamily="Cascadia Mono"
                                FontSize="13"
                                Text="msbuild VisualForge.vcxproj /p:GenerateCompileCommands=true&#x0a;clangd --compile-commands-dir=&lt;project&gt;&#x0a;lldb-dap"
                                TextWrapping="NoWrap" />
                        </Grid>
                    </TabViewItem>
                </TabView>

                <Border Grid.Row="1" Background="{StaticResource VisualForgeBorderBrush}" />

                <Grid Grid.Row="2" Background="{StaticResource VisualForgePanelBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="10,7"
                        BorderBrush="{StaticResource VisualForgeBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock FontWeight="SemiBold" Text="Output" />
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <TextBlock
                            Margin="12,10"
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            Text="VisualForge ready&#x0a;Tool registry: clangd, git, msbuild, cl.exe, vcpkg, nuget, lldb-dap&#x0a;Language service plan: restore -&gt; generate compile_commands -&gt; start clangd" />
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Column="3" Background="{StaticResource VisualForgeBorderBrush}" />

            <Grid Grid.Column="4" Background="{StaticResource VisualForgePanelBrush}">
                <TabView IsAddTabButtonVisible="False" TabWidthMode="Equal">
                    <TabViewItem Header="Git">
                        <Grid Background="{StaticResource VisualForgePanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource VisualForgeBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel
                                    Padding="10,8"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button Padding="8,4" ToolTipService.ToolTip="Stage all changes">
                                        <FontIcon FontSize="13" Glyph="&#xE710;" />
                                    </Button>
                                    <Button Padding="8,4" ToolTipService.ToolTip="Commit staged changes">
                                        <FontIcon FontSize="13" Glyph="&#xE74E;" />
                                    </Button>
                                    <Button Padding="8,4" ToolTipService.ToolTip="Sync repository">
                                        <FontIcon FontSize="13" Glyph="&#xE895;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <ListView Grid.Row="1" Margin="6">
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource VisualForgeWarningBrush}"
                                            Text="M" />
                                        <TextBlock Text="App.xaml.cpp" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource VisualForgeSuccessBrush}"
                                            Text="A" />
                                        <TextBlock Text="Integration/MSBuildAdapter.cpp" />
                                    </StackPanel>
                                </ListViewItem>
                                <ListViewItem>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource VisualForgeSuccessBrush}"
                                            Text="A" />
                                        <TextBlock Text="Tool/ToolRegistry.cpp" />
                                    </StackPanel>
                                </ListViewItem>
                            </ListView>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="Debug">
                        <Grid Background="{StaticResource VisualForgePanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource VisualForgeBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel
                                    Padding="10,8"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button Padding="8,4" ToolTipService.ToolTip="Continue">
                                        <FontIcon FontSize="13" Glyph="&#xE768;" />
                                    </Button>
                                    <Button Padding="8,4" ToolTipService.ToolTip="Step over">
                                        <FontIcon FontSize="13" Glyph="&#xE7FD;" />
                                    </Button>
                                    <Button Padding="8,4" ToolTipService.ToolTip="Stop debugging">
                                        <FontIcon FontSize="13" Glyph="&#xE71A;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="1" RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="12,10" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="Breakpoints" />
                                    <CheckBox Content="MainView.xaml.cpp:12" IsChecked="True" />
                                    <CheckBox Content="MSBuildAdapter.cpp:42" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontWeight="SemiBold"
                                        Text="Frames" />
                                </StackPanel>
                                <ListView Grid.Row="1" Margin="6,0,6,6">
                                    <ListViewItem Content="0  VisualForge.exe!MainView::MainView" />
                                    <ListViewItem Content="1  VisualForge.exe!MainWindow::MainWindow" />
                                    <ListViewItem Content="2  kernelbase.dll!BaseThreadInitThunk" />
                                </ListView>
                            </Grid>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem Header="Packages">
                        <Grid Background="{StaticResource VisualForgePanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource VisualForgeBorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel
                                    Padding="10,8"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button Padding="8,4" ToolTipService.ToolTip="Restore NuGet packages">
                                        <FontIcon FontSize="13" Glyph="&#xE896;" />
                                    </Button>
                                    <Button Padding="8,4" ToolTipService.ToolTip="Install vcpkg packages">
                                        <FontIcon FontSize="13" Glyph="&#xE7B8;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <ListView Grid.Row="1" Margin="6">
                                <ListViewItem Content="Microsoft.WindowsAppSDK 2.2.0" />
                                <ListViewItem Content="Microsoft.Windows.CppWinRT 3.0.260520.1" />
                                <ListViewItem Content="Microsoft.Graphics.Win2D 1.4.0" />
                                <ListViewItem Content="sentry-native (vcpkg)" />
                            </ListView>
                        </Grid>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="10,0"
            Background="{StaticResource VisualForgeChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock FontSize="12" Text="Ready" />
                <TextBlock FontSize="12" Text="clangd: compile_commands pending" />
                <TextBlock FontSize="12" Text="git: main" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Text="UTF-8  CRLF  C++23" />
        </Grid>
    </Grid>
</Page>
