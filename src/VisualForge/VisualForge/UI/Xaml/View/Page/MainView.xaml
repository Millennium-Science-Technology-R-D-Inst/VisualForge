<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VisualForge.UI.Xaml.View.Page.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VisualForge.UI.Xaml.View.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="using:VisualForge.UI.Xaml.View.Control"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:VisualForge.UI.Xaml.View.Page"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xtwc="using:XamlToolkit.WinUI.Controls"
    x:Name="RootPage"
    Loaded="Page_Loaded"
    PointerPressed="RootPage_PointerPressed"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Invoked="SaveKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="N"
            Invoked="NewFileKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="N"
            Invoked="NewProjectItemKeyboardAccelerator_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="S"
            Invoked="SaveAsKeyboardAccelerator_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="Z"
            Invoked="UndoKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Y"
            Invoked="RedoKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Z"
            Invoked="RedoKeyboardAccelerator_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="F"
            Invoked="FindKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="H"
            Invoked="ReplaceKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="G"
            Invoked="GoToLineKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="P"
            Invoked="QuickOpenKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Q"
            Invoked="CommandPaletteKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Tab"
            Invoked="NextDocumentKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Tab"
            Invoked="PreviousDocumentKeyboardAccelerator_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="F4"
            Invoked="CloseDocumentKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="I"
            Invoked="HoverKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="I"
            Invoked="FormatDocumentKeyboardAccelerator_Invoked"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="Enter"
            Invoked="CodeActionsKeyboardAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator Key="F12" Invoked="GoToDefinitionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="F12"
            Invoked="FindReferencesKeyboardAccelerator_Invoked"
            Modifiers="Shift" />
        <KeyboardAccelerator Key="F2" Invoked="RenameKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F9" Invoked="ToggleBreakpointKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="StartDebuggingKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="B"
            Invoked="BuildSolutionKeyboardAccelerator_Invoked"
            Modifiers="Control,Shift" />
    </Page.KeyboardAccelerators>

    <Grid Background="{StaticResource VFEditorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!--  Title Bar with menus  -->
        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Grid.Row="0"
            Height="48"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            BackRequested="AppTitleBar_BackRequested"
            IsTabStop="False">

            <TitleBar.LeftHeader>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <!--<FontIcon
                    FontSize="15"
                    Foreground="{StaticResource VFAccentBrush}"
                    Glyph="&#xE943;" />-->
                    <Image
                        x:Name="titleBarIcon"
                        Width="16"
                        Margin="10,0,10,0"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/AppIcons/Square44x44Logo.altform-lightunplated_targetsize-256.png" />
                    <MenuBar Background="Transparent">
                        <MenuBarItem Title="File">
                            <MenuFlyoutItem Click="NewFile_Click" Text="New File" />
                            <MenuFlyoutItem Click="NewProjectItem_Click" Text="New Project Item" />
                            <MenuFlyoutItem Click="NewProject_Click" Text="New Project" />
                            <MenuFlyoutItem Click="OpenWorkspace_Click" Text="Open Workspace" />
                            <MenuFlyoutSubItem x:Name="RecentWorkspacesMenu" Text="Recent Workspaces" />
                            <MenuFlyoutItem Click="OpenFile_Click" Text="Open File" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="SaveFile_Click" Text="Save" />
                            <MenuFlyoutItem Click="SaveAs_Click" Text="Save As..." />
                            <MenuFlyoutItem Click="RenameActiveFile_Click" Text="Rename Active File" />
                            <MenuFlyoutItem Click="DeleteActiveFile_Click" Text="Delete Active File" />
                            <MenuFlyoutItem Click="SaveAll_Click" Text="Save All" />
                            <MenuFlyoutItem Click="ExitMenu_Click" Text="Exit" />
                        </MenuBarItem>
                        <MenuBarItem Title="Build">
                            <MenuFlyoutItem Click="BuildProject_Click" Text="Build Solution" />
                            <MenuFlyoutItem Click="RebuildProject_Click" Text="Rebuild Solution" />
                            <MenuFlyoutItem Click="CleanProject_Click" Text="Clean Solution" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="BuildProjectOnly_Click" Text="Build Startup Project" />
                        </MenuBarItem>
                        <MenuBarItem Title="Edit">
                            <MenuFlyoutItem Click="Undo_Click" Text="Undo" />
                            <MenuFlyoutItem Click="Redo_Click" Text="Redo" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="Cut_Click" Text="Cut" />
                            <MenuFlyoutItem Click="Copy_Click" Text="Copy" />
                            <MenuFlyoutItem Click="Paste_Click" Text="Paste" />
                            <MenuFlyoutItem Click="SelectAll_Click" Text="Select All" />
                            <MenuFlyoutItem Click="RenameActiveSymbol_Click" Text="Rename Symbol" />
                            <MenuFlyoutItem Click="FormatDocument_Click" Text="Format Document" />
                            <MenuFlyoutItem Click="CodeActions_Click" Text="Quick Actions" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="GoToLine_Click" Text="Go To Line" />
                            <MenuFlyoutItem Click="FindInFiles_Click" Text="Find in Files" />
                        </MenuBarItem>
                        <MenuBarItem Title="View">
                            <MenuFlyoutItem Click="CommandPalette_Click" Text="Command Palette" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="EditingLayout_Click" Text="Editing Layout" />
                            <MenuFlyoutItem Click="DebuggingLayout_Click" Text="Debugging Layout" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Solution Explorer" />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Git Changes" />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Git Repository" />
                            <MenuFlyoutItem Click="UnavailableMenu_Click" Text="Team Explorer" />
                            <MenuFlyoutItem Click="UnavailableMenu_Click" Text="Server Explorer" />
                            <MenuFlyoutItem Click="UnavailableMenu_Click" Text="SQL Server Object Explorer" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Error List" />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Output" />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Terminal" />
                            <MenuFlyoutItem Click="UnavailableMenu_Click" Text="Toolbox" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="FullScreen_Click" Text="Full Screen" />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Properties Window" />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Document Outline" />
                        </MenuBarItem>
                        <MenuBarItem Title="Git">
                            <MenuFlyoutItem Click="GitCommit_Click" Text="Commit or Stash" />
                            <MenuFlyoutItem Click="GitPull_Click" Text="Pull" />
                            <MenuFlyoutItem Click="GitPush_Click" Text="Push" />
                            <MenuFlyoutItem Click="ManageBranches_Click" Text="Manage Branches" />
                        </MenuBarItem>
                        <MenuBarItem Title="Debug">
                            <MenuFlyoutItem Click="RunProject_Click" Text="Start Debugging" />
                            <MenuFlyoutItem Click="RunWithoutDebugging_Click" Text="Start Without Debugging" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="StepOverDebug_Click" Text="Step Over" />
                            <MenuFlyoutItem Click="StepInDebug_Click" Text="Step Into" />
                            <MenuFlyoutItem Click="StepOutDebug_Click" Text="Step Out" />
                            <MenuFlyoutItem Click="ViewToolWindow_Click" Text="Debug Windows" />
                        </MenuBarItem>
                        <MenuBarItem Title="Tools">
                            <MenuFlyoutItem Click="NuGetPackageManager_Click" Text="NuGet Package Manager" />
                            <MenuFlyoutItem Click="VcpkgPackageManager_Click" Text="vcpkg Package Manager" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="OptionsMenu_Click" Text="Options" />
                        </MenuBarItem>
                        <MenuBarItem Title="Extensions">
                            <MenuFlyoutItem Click="UnavailableMenu_Click" Text="Manage Extensions" />
                            <MenuFlyoutItem Click="UnavailableMenu_Click" Text="Plugin Developer Console" />
                        </MenuBarItem>
                        <MenuBarItem Title="Window">
                            <MenuFlyoutItem Click="ResetWindowLayout_Click" Text="Reset Window Layout" />
                            <MenuFlyoutItem Click="SaveWindowLayout_Click" Text="Save Window Layout" />
                        </MenuBarItem>
                        <MenuBarItem Title="Help">
                            <MenuFlyoutItem Click="UnavailableMenu_Click" Text="View Documentation" />
                            <MenuFlyoutItem Click="AboutMenu_Click" Text="About VisualForge" />
                        </MenuBarItem>
                    </MenuBar>
                </StackPanel>

            </TitleBar.LeftHeader>

            <TitleBar.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="QuickOpenBox"
                        Grid.Column="1"
                        Width="320"
                        Height="Auto"
                        Margin="14,1,0,1"
                        VerticalAlignment="Center"
                        PlaceholderText="Search files (Ctrl+P)"
                        QuerySubmitted="QuickOpenBox_QuerySubmitted"
                        TextChanged="QuickOpenBox_TextChanged" />
                </Grid>

            </TitleBar.Content>

            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,6,0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <StackPanel.Resources>
                        <Style
                            x:Key="SettingButtonStyle"
                            BasedOn="{StaticResource DefaultButtonStyle}"
                            TargetType="Button">
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="MinWidth" Value="120" />
                            <Setter Property="Padding" Value="16,6,16,6" />
                        </Style>
                    </StackPanel.Resources>
                    <Button
                        Padding="6"
                        Click="InvertAppThemeButton_Click"
                        Content="[Dev] Invert Theme"
                        Style="{ThemeResource SettingButtonStyle}"
                        Visibility="{x:Bind IsDebug, Mode=OneTime}" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--  Title command bar  -->
        <Grid
            Grid.Row="1"
            MinHeight="15"
            Padding="4,0,6,0"
            Background="{StaticResource VFMenuBrush}"
            BorderBrush="{StaticResource VFSoftBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <CommandBar
                    x:Name="EditorInformationCommandBar"
                    essential:CommandBarHelper.AcrylicWorkaround="True"
                    Background="Transparent"
                    CanDrag="True"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        x:Name="EditorInformationNavigationList"
                        AllowFocusOnInteraction="True"
                        Click="NavigateBack_Click"
                        Icon="{essential:FontIcon Glyph=&#xE760;}" />
                    <AppBarButton
                        AllowFocusOnInteraction="True"
                        Click="NavigateForward_Click"
                        Icon="{essential:FontIcon Glyph=&#xE761;}" />
                    <AppBarButton
                        AllowFocusOnInteraction="True"
                        Click="NewFile_Click"
                        Icon="{essential:FontIcon Glyph=&#xE8A5;}"
                        ToolTipService.ToolTip="New File (Ctrl+N)" />
                    <AppBarButton
                        AllowFocusOnInteraction="True"
                        Click="NewProjectItem_Click"
                        Icon="{essential:FontIcon Glyph=&#xF0B2;}"
                        ToolTipService.ToolTip="New Project Item (Ctrl+Shift+N)" />
                    <AppBarButton
                        Click="OpenWorkspace_Click"
                        Label="Open"
                        ToolTipService.ToolTip="Open workspace folder">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
                <xtwc:ContentSizer Grid.Column="1" TargetControl="{x:Bind EditorInformationCommandBar}" />


            </Grid>
            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Account">
                    <FontIcon FontSize="13" Glyph="&#xE77B;" />
                </Button>
                <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Notifications">
                    <FontIcon FontSize="13" Glyph="&#xE7F4;" />
                </Button>
                <Border
                    Margin="4,0,0,0"
                    Padding="7,3"
                    Background="{StaticResource VFPanelAltBrush}"
                    BorderBrush="{StaticResource VFBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock FontSize="11" Text="INSIDERS" />
                </Border>
            </StackPanel>
        </Grid>

        <!--  Title bar command bar information  -->
        <Grid
            Grid.Row="2"
            MinHeight="36"
            Padding="6,3"
            Background="{StaticResource VFChromeBrush}"
            BorderBrush="{StaticResource VFSoftBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsOpen="False"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton
                    Click="SaveAll_Click"
                    Label="Save All"
                    ToolTipService.ToolTip="Save all open files">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    Click="BuildProject_Click"
                    Label="Build"
                    ToolTipService.ToolTip="Build solution">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="RunProject_Click"
                    Label="Run"
                    ToolTipService.ToolTip="Start debugging">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="StopDebug_Click"
                    Label="Stop"
                    ToolTipService.ToolTip="Stop debugging">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE71A;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="CancelBuild_Click"
                    Label="Cancel Build"
                    ToolTipService.ToolTip="Cancel the active build">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE711;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    Click="RefreshGitChanges_Click"
                    Label="Git"
                    ToolTipService.ToolTip="Git changes">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="NuGetPackageManager_Click"
                    Label="Packages"
                    ToolTipService.ToolTip="Package managers">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <AutoSuggestBox
                    x:Name="FindTextBox"
                    Width="210"
                    PlaceholderText="Find"
                    TextChanged="FindTextBox_TextChanged" />
                <TextBox
                    x:Name="ReplaceTextBox"
                    Width="150"
                    PlaceholderText="Replace" />
                <ToggleButton
                    x:Name="MatchCaseToggle"
                    Checked="FindOptions_Changed"
                    Content="Aa"
                    ToolTipService.ToolTip="Match case"
                    Unchecked="FindOptions_Changed" />
                <ToggleButton
                    x:Name="WholeWordToggle"
                    Checked="FindOptions_Changed"
                    Content="ab"
                    ToolTipService.ToolTip="Match whole word"
                    Unchecked="FindOptions_Changed" />
                <Button
                    Click="FindPrevious_Click"
                    Style="{StaticResource VFIconButtonStyle}"
                    ToolTipService.ToolTip="Previous match">
                    <FontIcon Glyph="&#xE70E;" />
                </Button>
                <Button
                    Click="FindNext_Click"
                    Style="{StaticResource VFIconButtonStyle}"
                    ToolTipService.ToolTip="Next match">
                    <FontIcon Glyph="&#xE70D;" />
                </Button>
                <Button
                    Padding="8,4"
                    Click="Replace_Click"
                    Content="Replace" />
                <Button
                    Padding="8,4"
                    Click="ReplaceAll_Click"
                    Content="All" />
                <Button
                    Padding="8,4"
                    Click="FindInFiles_Click"
                    Content="Files"
                    ToolTipService.ToolTip="Find in workspace" />
                <Button
                    Padding="8,4"
                    Click="ReplaceInFiles_Click"
                    Content="Replace Files"
                    ToolTipService.ToolTip="Replace in workspace files" />
                <TextBlock
                    x:Name="FindSummaryText"
                    VerticalAlignment="Center"
                    Style="{StaticResource VFStatusTextBlockStyle}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="WorkspaceModeComboBox"
                    Width="124"
                    Height="28"
                    SelectedIndex="0"
                    SelectionChanged="WorkspaceModeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Editing" />
                    <ComboBoxItem Content="Debugging" />
                </ComboBox>
                <ComboBox
                    x:Name="ConfigurationComboBox"
                    Width="132"
                    Height="28"
                    SelectedIndex="0"
                    SelectionChanged="BuildConfiguration_SelectionChanged">
                    <ComboBoxItem Content="Debug" />
                    <ComboBoxItem Content="Release" />
                </ComboBox>
                <ComboBox
                    x:Name="PlatformComboBox"
                    Width="110"
                    Height="28"
                    SelectedIndex="0"
                    SelectionChanged="BuildPlatform_SelectionChanged">
                    <ComboBoxItem Content="x64" />
                    <ComboBoxItem Content="ARM64" />
                    <ComboBoxItem Content="Win32" />
                </ComboBox>
                <Border
                    Padding="8,4"
                    Background="{StaticResource VFEditorBrush}"
                    BorderBrush="{StaticResource VFBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{StaticResource VFSuccessBrush}" />
                        <TextBlock FontSize="12" Text="Local Windows Debugger" />
                    </StackPanel>
                </Border>
                <Button
                    Padding="8,4"
                    Click="OptionsMenu_Click"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition
                    x:Name="LeftToolColumn"
                    Width="250"
                    MinWidth="210" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="620" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition
                    x:Name="RightToolColumn"
                    Width="360"
                    MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource VFDockBrush}">
                <StackPanel Margin="0,6,0,0" Spacing="3">
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Tabs">
                        <FontIcon FontSize="13" Glyph="&#xE8A5;" />
                    </Button>
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Tool Windows">
                        <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                    </Button>
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Options">
                        <FontIcon FontSize="13" Glyph="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Bookmarks">
                        <FontIcon FontSize="13" Glyph="&#xE734;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="{StaticResource VFPanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="{StaticResource VFDockHeaderPadding}"
                    PointerMoved="DockTitleBar_PointerMoved"
                    PointerPressed="DockTitleBar_PointerPressed"
                    PointerReleased="DockTitleBar_PointerReleased"
                    Style="{StaticResource VFDockTitleBarStyle}"
                    Tag="tabs"
                    ToolTipService.ToolTip="Open documents">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,7,0"
                        Style="{StaticResource VFDockGlyphTextBlockStyle}"
                        Text="&#xE8A5;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource VFDockTitleTextBlockStyle}"
                        Text="Tabs" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            Click="NewFile_Click"
                            Style="{StaticResource VFIconButtonStyle}"
                            ToolTipService.ToolTip="New file">
                            <FontIcon FontSize="13" Glyph="&#xE8A5;" />
                        </Button>
                        <Button
                            Click="DockCommand_Click"
                            Style="{StaticResource VFIconButtonStyle}"
                            Tag="autohide-left"
                            ToolTipService.ToolTip="Auto hide">
                            <FontIcon FontSize="13" Glyph="&#xE77A;" />
                        </Button>
                        <Button
                            Click="DockCommand_Click"
                            Style="{StaticResource VFIconButtonStyle}"
                            Tag="close-left"
                            ToolTipService.ToolTip="Close">
                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <AutoSuggestBox
                    x:Name="OpenDocumentsSearchBox"
                    Grid.Row="1"
                    Margin="8,6,8,4"
                    PlaceholderText="Search open files"
                    TextChanged="OpenDocumentsSearchBox_TextChanged" />
                <ListView
                    x:Name="OpenDocumentsList"
                    Grid.Row="2"
                    Margin="4,0,4,4"
                    SelectionChanged="OpenDocumentsList_SelectionChanged"
                    SelectionMode="Single" />
                <Border
                    Grid.Row="3"
                    BorderBrush="{StaticResource VFBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <TextBlock
                        x:Name="OpenDocumentsSummaryText"
                        Margin="8,5"
                        Style="{StaticResource VFStatusTextBlockStyle}"
                        Text="No open documents" />
                </Border>
            </Grid>

            <xtwc:GridSplitter
                Grid.Column="2"
                Width="4"
                HorizontalAlignment="Stretch"
                Background="{StaticResource VFBorderBrush}"
                PointerReleased="LayoutSplitter_PointerReleased"
                ResizeBehavior="PreviousAndNext"
                ResizeDirection="Columns" />

            <Grid
                x:Name="EditorWorkspaceGrid"
                Grid.Column="3"
                Background="{StaticResource VFEditorBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        x:Name="EditorAreaRow"
                        Height="*"
                        MinHeight="260" />
                    <RowDefinition Height="4" />
                    <RowDefinition x:Name="BottomToolRow" Height="245" />
                </Grid.RowDefinitions>

                <TabView
                    x:Name="EditorTabs"
                    Grid.Row="0"
                    CanDragTabs="True"
                    IsAddTabButtonVisible="False"
                    SelectedIndex="1"
                    SelectionChanged="EditorTabs_SelectionChanged"
