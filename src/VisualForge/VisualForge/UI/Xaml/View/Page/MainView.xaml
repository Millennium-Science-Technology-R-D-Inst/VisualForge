                                    <TextBox
                                        x:Name="GitDiffOutputTextBox"
                                        AcceptsReturn="True"
                                        Background="{StaticResource VFEditorBrush}"
                                        BorderThickness="0"
                                        FontFamily="Cascadia Mono"
                                        FontSize="11"
                                        IsReadOnly="True"
                                        Padding="8"
                                        TextWrapping="NoWrap" />
                                </Border>
                            </Grid>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="Properties">
                        <Grid Background="{StaticResource VFPanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                PointerMoved="DockTitleBar_PointerMoved"
                                PointerPressed="DockTitleBar_PointerPressed"
                                PointerReleased="DockTitleBar_PointerReleased"
                                Style="{StaticResource VFDockTitleBarStyle}"
                                Tag="properties">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,7,0"
                                    Style="{StaticResource VFDockGlyphTextBlockStyle}"
                                    Text="&#xE700;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource VFDockTitleTextBlockStyle}"
                                    Text="Properties" />
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Float window">
                                        <FontIcon FontSize="13" Glyph="&#xE740;" />
                                    </Button>
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Close">
                                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Grid.Row="1"
                                Margin="10,8"
                                FontWeight="SemiBold"
                                Text="Selection" />
                            <Grid Grid.Row="2" Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Name" />
                                <TextBlock Grid.Column="1" Text="VisualForge" />
                                <TextBlock Grid.Row="1" Text="Kind" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="WinUI 3 C++/WinRT" />
                                <TextBlock Grid.Row="2" Text="Platform" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="x64" />
                            </Grid>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem x:Name="DebugToolsTab" Header="Debug Tools" Visibility="Collapsed">
                        <Grid Background="{StaticResource VFPanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="10,10,10,4"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Diagnostic Tools" />
                            <Grid Grid.Row="1" Margin="10,0,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="DebugSessionText"
                                    Style="{StaticResource VFStatusTextBlockStyle}"
                                    Text="No debug session" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <Button Click="ContinueDebug_Click" Content="&#xE768;" ToolTipService.ToolTip="Continue" />
                                    <Button Click="StepOverDebug_Click" Content="&#xE7A7;" ToolTipService.ToolTip="Step over" />
                                    <Button Click="StepInDebug_Click" Content="&#xE7A7;" ToolTipService.ToolTip="Step in" />
                                    <Button Click="StepOutDebug_Click" Content="&#xE7A7;" ToolTipService.ToolTip="Step out" />
                                    <Button Click="StopDebug_Click" Content="&#xE71A;" ToolTipService.ToolTip="Stop debugging" />
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="DebugEventsList" Grid.Row="2" Margin="6" />
                        </Grid>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>

        <!--  Floating Preview Host  -->
        <Border
            x:Name="FloatingPreviewHost"
