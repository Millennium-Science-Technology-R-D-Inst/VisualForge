            BorderBrush="{StaticResource VFAccentBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    PointerMoved="DockTitleBar_PointerMoved"
                    PointerPressed="DockTitleBar_PointerPressed"
                    PointerReleased="DockTitleBar_PointerReleased"
                    Style="{StaticResource VFDockTitleBarStyle}"
                    Tag="solutionExplorer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,7,0"
                        Style="{StaticResource VFDockGlyphTextBlockStyle}"
                        Text="&#xE700;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource VFDockTitleTextBlockStyle}"
                        Text="Solution Explorer" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Dock">
                            <FontIcon FontSize="13" Glyph="&#xE8A5;" />
                        </Button>
                        <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Close">
                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Margin="18"
                        BorderBrush="{StaticResource VFBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <Border
                        Grid.Column="1"
                        Margin="18"
                        BorderBrush="{StaticResource VFAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <Border
                        Grid.Column="2"
                        Margin="18"
                        BorderBrush="{StaticResource VFBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                </Grid>
            </Grid>
        </Border>

        <Grid
            Grid.Row="4"
            Padding="10,0"
            Background="{StaticResource VFMenuBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon FontSize="12" Glyph="&#xE930;" />
                <TextBlock
                    x:Name="ShellStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="Ready" />
                <TextBlock
                    x:Name="LanguageServiceStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="clangd: waiting for compile_commands.json" />
                <TextBlock
                    x:Name="BuildStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="MSBuild: not evaluated" />
                <TextBlock
                    x:Name="DebugStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="DAP: offline" />
                <TextBlock
                    x:Name="GitBranchStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="git: unavailable" />
                <TextBlock
                    x:Name="ProblemStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="0 Errors" />
                <TextBlock
                    x:Name="EditorPositionText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="Ln 1, Col 1" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                Style="{StaticResource VFStatusTextBlockStyle}"
                Text="UTF-8  CRLF  C++23" />
        </Grid>
    </Grid>
</Page>
