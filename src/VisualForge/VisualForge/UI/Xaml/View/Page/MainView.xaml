                                <ListView
                                    x:Name="GitChangesList"
                                    Margin="6"
                                    SelectionChanged="GitChangesList_SelectionChanged" />
                                <Border
                                    Grid.Row="1"
                                    Margin="6,0,6,6"
                                    BorderBrush="{StaticResource VFBorderBrush}"
