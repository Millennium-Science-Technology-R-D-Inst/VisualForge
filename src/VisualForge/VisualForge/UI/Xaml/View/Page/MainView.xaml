                            Style="{StaticResource VFDockTitleTextBlockStyle}"
                            Text="Error List - Current Project" />
                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Auto hide">
                                <FontIcon FontSize="13" Glyph="&#xE77A;" />
                            </Button>
                            <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Float window">
                                <FontIcon FontSize="13" Glyph="&#xE740;" />
                            </Button>
                            <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Maximize">
                                <FontIcon FontSize="13" Glyph="&#xE922;" />
                            </Button>
                            <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Close">
                                <FontIcon FontSize="13" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        Padding="{StaticResource VFDockHeaderPadding}"
                        BorderBrush="{StaticResource VFBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <ComboBox
                                Width="130"
                                Height="28"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Current Project" />
                                <ComboBoxItem Content="Entire Solution" />
                            </ComboBox>
                            <Border
                                Padding="7,4"
                                Background="#2C1722"
                                BorderBrush="{StaticResource VFDangerBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBlock x:Name="ErrorCountText" FontSize="11" Text="0 Errors" />
                            </Border>
                            <Border
                                Padding="7,4"
                                Background="#2B2414"
                                BorderBrush="{StaticResource VFWarningBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBlock x:Name="WarningCountText" FontSize="11" Text="0 Warnings" />
                            </Border>
                            <Border
                                Padding="7,4"
                                Background="#142231"
                                BorderBrush="{StaticResource VFAccentBlueBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBlock x:Name="MessageCountText" FontSize="11" Text="0 Messages" />
                            </Border>
                        </StackPanel>
                        <AutoSuggestBox
                            Grid.Column="2"
                            Width="170"
                            Height="28"
                            PlaceholderText="Search Error List" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <Grid
                            Padding="12,0"
                            BorderBrush="{StaticResource VFSoftBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource VFStatusTextBlockStyle}" Text="Code" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource VFStatusTextBlockStyle}"
                                Text="Description" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource VFStatusTextBlockStyle}"
                                Text="Project" />
                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource VFStatusTextBlockStyle}"
                                Text="File" />
                            <TextBlock
                                Grid.Column="4"
                                Style="{StaticResource VFStatusTextBlockStyle}"
                                Text="Line" />
                        </Grid>
                        <TabView
                            Grid.Row="1"
                            IsAddTabButtonVisible="False"
                            TabWidthMode="SizeToContent">
                            <TabViewItem Header="Error List">
                                <ListView
                                    x:Name="DiagnosticsList"
                                    Margin="12,4,12,8"
                                    SelectionChanged="DiagnosticsList_SelectionChanged" />
                            </TabViewItem>
                            <TabViewItem Header="Search Results">
                                <ListView
                                    x:Name="SearchResultsList"
                                    Margin="12,4,12,8"
                                    SelectionChanged="SearchResultsList_SelectionChanged" />
                            </TabViewItem>
                        </TabView>
                        <TabView
                            x:Name="BottomToolTabs"
                            Grid.Row="2"
                            IsAddTabButtonVisible="False"
                            SelectionChanged="BottomToolTabs_SelectionChanged"
                            TabWidthMode="SizeToContent">
                            <TabViewItem Header="Developer PowerShell">
                                <Grid Background="{StaticResource VFEditorBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        x:Name="TerminalOutputTextBox"
                                        AcceptsReturn="True"
                                        Background="{StaticResource VFEditorBrush}"
                                        BorderThickness="0"
                                        FontFamily="Cascadia Mono"
                                        FontSize="12"
                                        IsReadOnly="True"
                                        Padding="10,6"
                                        TextWrapping="NoWrap" />
                                    <Grid Grid.Row="1" Margin="8,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="TerminalCommandBox"
                                            Height="30"
                                            PlaceholderText="PowerShell command" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="ExecuteTerminal_Click"
                                            Content="&#xE768;"
                                            ToolTipService.ToolTip="Execute command" />
                                    </Grid>
                                </Grid>
                            </TabViewItem>
                            <TabViewItem Header="Output">
                                <Grid Background="{StaticResource VFEditorBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Padding="8,3"
                                        BorderBrush="{StaticResource VFSoftBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="2,0,12,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource VFStatusTextBlockStyle}"
                                                Text="Build and IDE Output" />
                                            <Button
                                                Click="ClearOutput_Click"
                                                Content="&#xE74D;"
                                                ToolTipService.ToolTip="Clear output" />
                                        </StackPanel>
                                    </Border>
                                    <TextBox
                                        x:Name="OutputTextBox"
                                        Grid.Row="1"
                                        AcceptsReturn="True"
                                        Background="{StaticResource VFEditorBrush}"
                                        BorderThickness="0"
                                        FontFamily="Cascadia Mono"
                                        FontSize="12"
                                        IsReadOnly="True"
                                        Padding="10,6"
                                        TextWrapping="NoWrap" />
                                </Grid>
                            </TabViewItem>
                            <TabViewItem Header="Terminal">
                                <TextBlock
                                    Margin="12"
                                    Style="{StaticResource VFStatusTextBlockStyle}"
                                    Text="Use Developer PowerShell for workspace commands." />
                            </TabViewItem>
                            <TabViewItem x:Name="CallStackTab" Header="Call Stack" Visibility="Collapsed">
                                <ListView
                                    x:Name="CallStackList"
                                    SelectionChanged="CallStackList_SelectionChanged" />
                            </TabViewItem>
                            <TabViewItem x:Name="LocalsTab" Header="Locals" Visibility="Collapsed">
                                <ListView x:Name="LocalsList" />
                            </TabViewItem>
                        </TabView>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Column="4" Background="{StaticResource VFBorderBrush}" />

            <Grid x:Name="RightToolWindowGrid" Grid.Column="5" Background="{StaticResource VFPanelBrush}">
                <TabView
                    x:Name="RightToolTabs"
                    IsAddTabButtonVisible="False"
                    SelectionChanged="RightToolTabs_SelectionChanged"
                    TabWidthMode="Equal">
                    <TabViewItem Header="Solution Explorer">
                        <Grid Background="{StaticResource VFPanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                PointerMoved="DockTitleBar_PointerMoved"
                                PointerPressed="DockTitleBar_PointerPressed"
                                PointerReleased="DockTitleBar_PointerReleased"
                                Style="{StaticResource VFDockTitleBarStyle}"
                                Tag="solutionExplorer">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,7,0"
                                    Style="{StaticResource VFDockGlyphTextBlockStyle}"
                                    Text="&#xE700;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource VFDockTitleTextBlockStyle}"
                                    Text="Solution Explorer" />
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Auto hide">
                                        <FontIcon FontSize="13" Glyph="&#xE77A;" />
                                    </Button>
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Float window">
                                        <FontIcon FontSize="13" Glyph="&#xE740;" />
                                    </Button>
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Close">
                                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border
                                Grid.Row="1"
                                BorderBrush="{StaticResource VFBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <StackPanel
                                    Padding="10,8"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Properties">
                                        <FontIcon FontSize="13" Glyph="&#xE713;" />
                                    </Button>
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Show all files">
                                        <FontIcon FontSize="13" Glyph="&#xE8A5;" />
                                    </Button>
                                    <Button Click="RefreshSolutionExplorer_Click" Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Refresh">
                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <controls:SolutionExplorerControl
                                x:Name="SolutionExplorer"
                                Grid.Row="2" />
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="Git Changes">
                        <Grid Background="{StaticResource VFPanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                PointerMoved="DockTitleBar_PointerMoved"
                                PointerPressed="DockTitleBar_PointerPressed"
                                PointerReleased="DockTitleBar_PointerReleased"
                                Style="{StaticResource VFDockTitleBarStyle}"
                                Tag="gitChanges">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,7,0"
                                    Style="{StaticResource VFDockGlyphTextBlockStyle}"
                                    Text="&#xE700;" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource VFDockTitleTextBlockStyle}"
                                    Text="Git Changes" />
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Float window">
                                        <FontIcon FontSize="13" Glyph="&#xE740;" />
                                    </Button>
                                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Close">
                                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border
                                Grid.Row="1"
                                BorderBrush="{StaticResource VFBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <StackPanel
                                    Padding="10,8"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Button Click="RefreshGitChanges_Click" Padding="8,4" Content="Refresh" />
                                    <Button Padding="8,4" Content="Pull" />
                                    <Button Padding="8,4" Content="Push" />
                                    <TextBlock
                                        x:Name="GitChangeSummaryText"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource VFStatusTextBlockStyle}"
                                        Text="No repository loaded" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="160" />
