                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Name" />
                                <TextBlock
                                    x:Name="PropertyNameValue"
                                    Grid.Column="1"
                                    Text="No document"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Text="Kind" />
                                <TextBlock
                                    x:Name="PropertyKindValue"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="WinUI 3 C++/WinRT" />
                                <TextBlock Grid.Row="2" Text="Path" />
                                <TextBlock
                                    x:Name="PropertyPathValue"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="No document"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="3" Text="Configuration" />
                                <TextBlock
                                    x:Name="PropertyConfigurationValue"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="Debug" />
                                <TextBlock Grid.Row="4" Text="Platform" />
                                <TextBlock
                                    x:Name="PropertyPlatformValue"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="x64" />
                                <TextBlock Grid.Row="5" Text="State" />
                                <TextBlock
                                    x:Name="PropertyStateValue"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="No document" />
                                <Button
                                    x:Name="SetStartupProjectButton"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Click="SetStartupProject_Click"
                                    Content="Set as Startup Project"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem
                        x:Name="DebugToolsTab"
                        Header="Debug Tools"
                        Visibility="Collapsed">
                        <Grid Background="{StaticResource VFPanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Margin="10,10,10,4"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Diagnostic Tools" />
                            <Grid Grid.Row="1" Margin="10,0,10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="DebugSessionText"
                                    Style="{StaticResource VFStatusTextBlockStyle}"
                                    Text="No debug session" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Click="ContinueDebug_Click"
                                        Content="&#xE768;"
                                        ToolTipService.ToolTip="Continue" />
                                    <Button
                                        Click="StepOverDebug_Click"
                                        Content="&#xE7A7;"
                                        ToolTipService.ToolTip="Step over" />
                                    <Button
                                        Click="StepInDebug_Click"
                                        Content="&#xE7A7;"
                                        ToolTipService.ToolTip="Step in" />
                                    <Button
                                        Click="StepOutDebug_Click"
                                        Content="&#xE7A7;"
                                        ToolTipService.ToolTip="Step out" />
                                    <Button
                                        Click="StopDebug_Click"
                                        Content="&#xE71A;"
                                        ToolTipService.ToolTip="Stop debugging" />
                                </StackPanel>
                            </Grid>
                            <ListView
                                x:Name="DebugEventsList"
                                Grid.Row="2"
                                Margin="6" />
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="Document Outline">
                        <Grid Background="{StaticResource VFPanelBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                Padding="8,6"
                                BorderBrush="{StaticResource VFBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Document Outline" />
                                <Button
                                    Grid.Column="1"
                                    Click="RefreshDocumentOutline_Click"
                                    Style="{StaticResource VFIconButtonStyle}"
                                    ToolTipService.ToolTip="Refresh document outline">
                                    <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                </Button>
                            </Grid>
                            <ListView
                                x:Name="DocumentOutlineList"
                                Grid.Row="1"
                                Margin="4"
                                SelectionChanged="DocumentOutlineList_SelectionChanged" />
                        </Grid>
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>

        <!--  Floating Preview Host  -->
        <Border
            x:Name="FloatingPreviewHost"
            Grid.Row="2"
            Width="760"
            Height="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource VFPanelBrush}"
            BorderBrush="{StaticResource VFAccentBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    PointerMoved="DockTitleBar_PointerMoved"
                    PointerPressed="DockTitleBar_PointerPressed"
                    PointerReleased="DockTitleBar_PointerReleased"
                    Style="{StaticResource VFDockTitleBarStyle}"
                    Tag="solutionExplorer">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,7,0"
                        Style="{StaticResource VFDockGlyphTextBlockStyle}"
                        Text="&#xE700;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource VFDockTitleTextBlockStyle}"
                        Text="Solution Explorer" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Dock">
                            <FontIcon FontSize="13" Glyph="&#xE8A5;" />
                        </Button>
                        <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Close">
                            <FontIcon FontSize="13" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Margin="18"
                        BorderBrush="{StaticResource VFBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <Border
                        Grid.Column="1"
                        Margin="18"
                        BorderBrush="{StaticResource VFAccentBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                    <Border
                        Grid.Column="2"
                        Margin="18"
                        BorderBrush="{StaticResource VFBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                </Grid>
            </Grid>
        </Border>

        <Grid
            Grid.Row="4"
            Padding="10,0"
            Background="{StaticResource VFMenuBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <FontIcon FontSize="12" Glyph="&#xE930;" />
                <TextBlock
                    x:Name="ShellStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="Ready" />
                <TextBlock
                    x:Name="LanguageServiceStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="clangd: waiting for compile_commands.json" />
                <TextBlock
                    x:Name="BuildStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="MSBuild: not evaluated" />
                <TextBlock
                    x:Name="DebugStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="DAP: offline" />
                <TextBlock
                    x:Name="GitBranchStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="git: unavailable" />
                <TextBlock
                    x:Name="ProblemStatusText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="0 Errors" />
                <TextBlock
                    x:Name="EditorPositionText"
                    Style="{StaticResource VFStatusTextBlockStyle}"
                    Text="Ln 1, Col 1" />
            </StackPanel>
            <TextBlock
                Grid.Column="2"
                Style="{StaticResource VFStatusTextBlockStyle}"
                Text="UTF-8  CRLF  C++23" />
        </Grid>
    </Grid>
</Page>
