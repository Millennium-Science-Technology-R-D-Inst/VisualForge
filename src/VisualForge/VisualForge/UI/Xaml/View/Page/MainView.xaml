<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VisualForge.UI.Xaml.View.Page.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:controls="using:VisualForge.UI.Xaml.View.Control"
    xmlns:editor="using:VisualForge.UI.Xaml.View.Control"
    xmlns:local="using:VisualForge.UI.Xaml.View.Page"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xtwc="using:XamlToolkit.WinUI.Controls"
    x:Name="RootPage"
    Loaded="Page_Loaded"
    PointerPressed="RootPage_PointerPressed"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewFileKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SaveAsKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Z" Modifiers="Control" Invoked="UndoKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="Y" Modifiers="Control" Invoked="RedoKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="H" Modifiers="Control" Invoked="ReplaceKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="GoToLineKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="P" Modifiers="Control" Invoked="QuickOpenKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="HoverKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F12" Invoked="GoToDefinitionKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F9" Invoked="ToggleBreakpointKeyboardAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="StartDebuggingKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{StaticResource VFEditorBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!--  Title Bar with menus  -->
        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Grid.Row="0"
            Height="48"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            BackRequested="AppTitleBar_BackRequested"
            IsTabStop="False">

            <TitleBar.LeftHeader>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <!--<FontIcon
                    FontSize="15"
                    Foreground="{StaticResource VFAccentBrush}"
                    Glyph="&#xE943;" />-->
                    <Image
                        x:Name="titleBarIcon"
                        Width="16"
                        Margin="10,0,10,0"
                        AutomationProperties.AccessibilityView="Raw"
                        Source="ms-appx:///Assets/AppIcons/Square44x44Logo.altform-lightunplated_targetsize-256.png" />
                    <MenuBar Background="Transparent">
                        <MenuBarItem Title="File">
                            <MenuFlyoutItem Text="New File" Click="NewFile_Click" />
                            <MenuFlyoutItem Text="New Project" />
                            <MenuFlyoutItem Text="Open Workspace" Click="OpenWorkspace_Click" />
                            <MenuFlyoutItem Text="Open File" Click="OpenFile_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Save" Click="SaveFile_Click" />
                            <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click" />
                            <MenuFlyoutItem Text="Save All" Click="SaveAll_Click" />
                            <MenuFlyoutItem Text="Exit" />
                        </MenuBarItem>
                        <MenuBarItem Title="Edit">
                            <MenuFlyoutItem Text="Undo" Click="Undo_Click" />
                            <MenuFlyoutItem Text="Redo" Click="Redo_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Go To Line" Click="GoToLine_Click" />
                            <MenuFlyoutItem Text="Find in Files" Click="FindInFiles_Click" />
                        </MenuBarItem>
                        <MenuBarItem Title="View">
                            <MenuFlyoutItem Text="Editing Layout" Click="EditingLayout_Click" />
                            <MenuFlyoutItem Text="Debugging Layout" Click="DebuggingLayout_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Solution Explorer" />
                            <MenuFlyoutItem Text="Git Changes" />
                            <MenuFlyoutItem Text="Git Repository" />
                            <MenuFlyoutItem Text="Team Explorer" />
                            <MenuFlyoutItem Text="Server Explorer" />
                            <MenuFlyoutItem Text="SQL Server Object Explorer" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Error List" />
                            <MenuFlyoutItem Text="Output" />
                            <MenuFlyoutItem Text="Terminal" />
                            <MenuFlyoutItem Text="Toolbox" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Full Screen" />
                            <MenuFlyoutItem Text="Properties Window" />
                        </MenuBarItem>
                        <MenuBarItem Title="Git">
                            <MenuFlyoutItem Text="Commit or Stash" />
                            <MenuFlyoutItem Text="Pull" />
                            <MenuFlyoutItem Text="Push" />
                            <MenuFlyoutItem Text="Manage Branches" />
                        </MenuBarItem>
                        <MenuBarItem Title="Debug">
                            <MenuFlyoutItem Text="Start Debugging" Click="RunProject_Click" />
                            <MenuFlyoutItem Text="Start Without Debugging" Click="RunProject_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Step Over" />
                            <MenuFlyoutItem Text="Step Into" />
                            <MenuFlyoutItem Text="Step Out" />
                            <MenuFlyoutItem Text="Debug Windows" />
                        </MenuBarItem>
                        <MenuBarItem Title="Tools">
                            <MenuFlyoutItem Text="NuGet Package Manager" />
                            <MenuFlyoutItem Text="vcpkg Package Manager" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Options" />
                        </MenuBarItem>
                        <MenuBarItem Title="Extensions">
                            <MenuFlyoutItem Text="Manage Extensions" />
                            <MenuFlyoutItem Text="Plugin Developer Console" />
                        </MenuBarItem>
                        <MenuBarItem Title="Window">
                            <MenuFlyoutItem Text="Reset Window Layout" />
                            <MenuFlyoutItem Text="Save Window Layout" />
                        </MenuBarItem>
                        <MenuBarItem Title="Help">
                            <MenuFlyoutItem Text="View Documentation" />
                            <MenuFlyoutItem Text="About VisualForge" />
                        </MenuBarItem>
                    </MenuBar>
                </StackPanel>

            </TitleBar.LeftHeader>

            <TitleBar.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="QuickOpenBox"
                        Grid.Column="1"
                        Width="320"
                        Height="Auto"
                        Margin="14,1,0,1"
                        VerticalAlignment="Center"
                        PlaceholderText="Search files (Ctrl+P)"
                        QuerySubmitted="QuickOpenBox_QuerySubmitted"
                        TextChanged="QuickOpenBox_TextChanged" />
                </Grid>

            </TitleBar.Content>

            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,6,0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <StackPanel.Resources>
                        <Style
                            x:Key="SettingButtonStyle"
                            BasedOn="{StaticResource DefaultButtonStyle}"
                            TargetType="Button">
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="MinWidth" Value="120" />
                            <Setter Property="Padding" Value="16,6,16,6" />
                        </Style>
                    </StackPanel.Resources>
                    <Button
                        Padding="6"
                        Click="InvertAppThemeButton_Click"
                        Content="[Dev] Invert Theme"
                        Style="{ThemeResource SettingButtonStyle}"
                        Visibility="{x:Bind IsDebug, Mode=OneTime}" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--  Title command bar  -->
        <Grid
            Grid.Row="1"
            MinHeight="15"
            Padding="4,0,6,0"
            Background="{StaticResource VFMenuBrush}"
            BorderBrush="{StaticResource VFSoftBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <CommandBar
                    x:Name="EditorInformationCommandBar"
                    essential:CommandBarHelper.AcrylicWorkaround="True"
                    Background="Transparent"
                    CanDrag="True"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        x:Name="EditorInformationNavigationList"
                        AllowFocusOnInteraction="True"
                        Icon="{essential:FontIcon Glyph=&#xE760;}" />
                    <AppBarButton AllowFocusOnInteraction="True" Icon="{essential:FontIcon Glyph=&#xE761;}" />
                    <AppBarButton
                        AllowFocusOnInteraction="True"
                        Click="NewFile_Click"
                        Icon="{essential:FontIcon Glyph=&#xE8A5;}"
                        ToolTipService.ToolTip="New File (Ctrl+N)" />
                    <AppBarButton
                        AllowFocusOnInteraction="True"
                        Icon="{essential:FontIcon Glyph=&#xF0B2;}"
                        ToolTipService.ToolTip="New Project Item (Ctrl+Shift+N)" />
                    <AppBarButton Label="Open" Click="OpenWorkspace_Click" ToolTipService.ToolTip="Open workspace folder">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8E5;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
                <xtwc:ContentSizer Grid.Column="1" TargetControl="{x:Bind EditorInformationCommandBar}" />


            </Grid>
            <StackPanel
                Grid.Column="3"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Account">
                    <FontIcon FontSize="13" Glyph="&#xE77B;" />
                </Button>
                <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Notifications">
                    <FontIcon FontSize="13" Glyph="&#xE7F4;" />
                </Button>
                <Border
                    Margin="4,0,0,0"
                    Padding="7,3"
                    Background="{StaticResource VFPanelAltBrush}"
                    BorderBrush="{StaticResource VFBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock FontSize="11" Text="INSIDERS" />
                </Border>
            </StackPanel>
        </Grid>

        <!--  Title bar command bar information  -->
        <Grid
            Grid.Row="2"
            MinHeight="36"
            Padding="6,3"
            Background="{StaticResource VFChromeBrush}"
            BorderBrush="{StaticResource VFSoftBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar
                HorizontalAlignment="Left"
                Background="Transparent"
                DefaultLabelPosition="Collapsed"
                IsOpen="False"
                OverflowButtonVisibility="Collapsed">
                <AppBarButton Label="Save All" Click="SaveAll_Click" ToolTipService.ToolTip="Save all open files">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Build" Click="BuildProject_Click" ToolTipService.ToolTip="Build solution">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Run" Click="RunProject_Click" ToolTipService.ToolTip="Start debugging">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Stop" ToolTipService.ToolTip="Stop debugging">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE71A;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Git" ToolTipService.ToolTip="Git changes">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Packages" ToolTipService.ToolTip="Package managers">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <AutoSuggestBox
                    x:Name="FindTextBox"
                    Width="210"
                    PlaceholderText="Find"
                    TextChanged="FindTextBox_TextChanged" />
                <TextBox x:Name="ReplaceTextBox" Width="150" PlaceholderText="Replace" />
                <ToggleButton x:Name="MatchCaseToggle" Content="Aa" Checked="FindOptions_Changed" Unchecked="FindOptions_Changed" ToolTipService.ToolTip="Match case" />
                <ToggleButton x:Name="WholeWordToggle" Content="ab" Checked="FindOptions_Changed" Unchecked="FindOptions_Changed" ToolTipService.ToolTip="Match whole word" />
                <Button Click="FindPrevious_Click" Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Previous match">
                    <FontIcon Glyph="&#xE70E;" />
                </Button>
                <Button Click="FindNext_Click" Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Next match">
                    <FontIcon Glyph="&#xE70D;" />
                </Button>
                <Button Click="Replace_Click" Padding="8,4" Content="Replace" />
                <Button Click="ReplaceAll_Click" Padding="8,4" Content="All" />
                <Button Click="FindInFiles_Click" Padding="8,4" Content="Files" ToolTipService.ToolTip="Find in workspace" />
                <TextBlock x:Name="FindSummaryText" VerticalAlignment="Center" Style="{StaticResource VFStatusTextBlockStyle}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ComboBox
                    x:Name="WorkspaceModeComboBox"
                    Width="124"
                    Height="28"
                    SelectionChanged="WorkspaceModeComboBox_SelectionChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Editing" />
                    <ComboBoxItem Content="Debugging" />
                </ComboBox>
                <ComboBox
                    Width="132"
                    Height="28"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Debug" />
                    <ComboBoxItem Content="Release" />
                </ComboBox>
                <ComboBox
                    Width="110"
                    Height="28"
                    SelectedIndex="0">
                    <ComboBoxItem Content="x64" />
                    <ComboBoxItem Content="ARM64" />
                    <ComboBoxItem Content="Win32" />
                </ComboBox>
                <Border
                    Padding="8,4"
                    Background="{StaticResource VFEditorBrush}"
                    BorderBrush="{StaticResource VFBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="{StaticResource VFSuccessBrush}" />
                        <TextBlock FontSize="12" Text="Local Windows Debugger" />
                    </StackPanel>
                </Border>
                <Button Padding="8,4" ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="250" MinWidth="210" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" MinWidth="620" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="360" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource VFDockBrush}">
                <StackPanel Margin="0,6,0,0" Spacing="3">
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Tabs">
                        <FontIcon FontSize="13" Glyph="&#xE8A5;" />
                    </Button>
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Tool Windows">
                        <FontIcon FontSize="13" Glyph="&#xE8B7;" />
                    </Button>
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Options">
                        <FontIcon FontSize="13" Glyph="&#xE713;" />
                    </Button>
                    <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Bookmarks">
                        <FontIcon FontSize="13" Glyph="&#xE734;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Background="{StaticResource VFPanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="{StaticResource VFDockHeaderPadding}"
                    PointerMoved="DockTitleBar_PointerMoved"
                    PointerPressed="DockTitleBar_PointerPressed"
                    PointerReleased="DockTitleBar_PointerReleased"
                    Style="{StaticResource VFDockTitleBarStyle}"
                    Tag="options"
                    ToolTipService.ToolTip="Options">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,7,0"
                        Style="{StaticResource VFDockGlyphTextBlockStyle}"
                        Text="&#xE700;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource VFDockTitleTextBlockStyle}"
                        Text="Options" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Search settings">
                            <FontIcon FontSize="13" Glyph="&#xE721;" />
                        </Button>
                        <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Pin">
                            <FontIcon FontSize="13" Glyph="&#xE718;" />
                        </Button>
                        <Button Style="{StaticResource VFIconButtonStyle}" ToolTipService.ToolTip="Float window">
                            <FontIcon FontSize="13" Glyph="&#xE740;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <AutoSuggestBox Margin="8" PlaceholderText="Search options" />
                    <TreeView
                        Grid.Row="1"
                        Margin="4,0,4,6"
                        SelectionMode="Single">
                        <TreeView.RootNodes>
                            <TreeViewNode Content="Environment" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="General" />
                                    <TreeViewNode Content="Fonts and Colors" />
                                    <TreeViewNode Content="Keyboard" />
                                    <TreeViewNode Content="Startup" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Text Editor" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="General" IsExpanded="True" />
                                    <TreeViewNode Content="C/C++" />
                                    <TreeViewNode Content="XAML" />
                                    <TreeViewNode Content="Code Cleanup" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Projects and Solutions" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Build and Run" />
                                    <TreeViewNode Content="VC++ Directories" />
                                    <TreeViewNode Content="CMake" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Source Control" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="Git Global Settings" />
                                    <TreeViewNode Content="Git Repository Settings" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Debugging" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="General" />
                                    <TreeViewNode Content="Symbols" />
                                    <TreeViewNode Content="NatVis" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                            <TreeViewNode Content="Package Managers" IsExpanded="True">
                                <TreeViewNode.Children>
                                    <TreeViewNode Content="NuGet" />
                                    <TreeViewNode Content="vcpkg" />
                                </TreeViewNode.Children>
                            </TreeViewNode>
                        </TreeView.RootNodes>
                    </TreeView>
                </Grid>

                <Border
                    Grid.Row="2"
                    BorderBrush="{StaticResource VFBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel
                        Padding="8,5"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock FontSize="11" Text="Do you like this experience?" />
                        <FontIcon FontSize="12" Glyph="&#xE8E1;" />
                        <FontIcon FontSize="12" Glyph="&#xE8E0;" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource VFBorderBrush}" />

            <Grid x:Name="EditorWorkspaceGrid" Grid.Column="3" Background="{StaticResource VFEditorBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="EditorAreaRow" Height="*" MinHeight="260" />
                    <RowDefinition Height="1" />
                    <RowDefinition x:Name="BottomToolRow" Height="245" />
                </Grid.RowDefinitions>

                <TabView
                    x:Name="EditorTabs"
                    Grid.Row="0"
                    CanDragTabs="True"
                    IsAddTabButtonVisible="False"
                    SelectionChanged="EditorTabs_SelectionChanged"
                    TabCloseRequested="EditorTabs_TabCloseRequested"
                    TabWidthMode="SizeToContent">
                    <TabViewItem Header="Options">
                        <Grid Background="{StaticResource VFEditorBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid
                                Padding="12,6"
                                BorderBrush="{StaticResource VFBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <AutoSuggestBox
                                    Width="240"
                                    Height="30"
                                    PlaceholderText="Search" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="14,0,6,0"
                                    Style="{StaticResource VFStatusTextBlockStyle}"
                                    Text="Filter:" />
                                <ComboBox
                                    Grid.Column="2"
                                    Width="150"
                                    Height="30"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="All Settings" />
                                    <ComboBoxItem Content="Changed Settings" />
                                </ComboBox>
                                <ComboBox
                                    Grid.Column="3"
                                    Width="170"
                                    Height="30"
                                    Margin="8,0,0,0"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="user (current install)" />
                                    <ComboBoxItem Content="workspace" />
                                </ComboBox>
                                <StackPanel
                                    Grid.Column="5"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Button Padding="8,4" Content="Edit JSON" />
                                    <Button Padding="8,4" Content="Sync" />
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1">
                                <Grid
                                    MaxWidth="980"
                                    Padding="16,16,24,24"
                                    HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        FontSize="22"
                                        FontWeight="SemiBold"
                                        Text="All Settings &gt; Text Editor" />

                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="0,18,0,0"
                                        Spacing="10">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="General" />
                                        <CheckBox Content="Drag and drop text editing" IsChecked="True" />
                                        <CheckBox Content="Select subword on double click" />
                                        <CheckBox Content="Cut or Copy the current line without selection" IsChecked="True" />
                                        <CheckBox Content="Automatic delimiter highlighting" IsChecked="True" />
                                        <CheckBox Content="Track changes" IsChecked="True" />
                                        <StackPanel Margin="40,0,0,0" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Tracking mode" />
                                            <ComboBox Width="300" SelectedIndex="0">
                                                <ComboBoxItem Content="Git changes" />
                                                <ComboBoxItem Content="All file changes" />
                                            </ComboBox>
                                        </StackPanel>
                                        <CheckBox Content="Auto-detect UTF-8 encoding without signature" IsChecked="True" />
                                        <CheckBox Content="Follow project coding conventions" IsChecked="True" />
                                        <CheckBox Content="Enable image hover preview" IsChecked="True" />
                                        <CheckBox Content="Enable spell checker" />
                                        <CheckBox Content="Enable audio cues" />
                                        <CheckBox Content="Enable mouse click to perform Go to Definition" IsChecked="True" />
                                        <StackPanel Margin="40,0,0,0" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="Modifier key" />
                                            <ComboBox Width="300" SelectedIndex="0">
                                                <ComboBoxItem Content="Ctrl" />
                                                <ComboBoxItem Content="Alt" />
                                            </ComboBox>
                                        </StackPanel>
