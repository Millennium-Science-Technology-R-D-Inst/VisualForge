<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VisualForge">

    <Color x:Key="VFChromeColor">#11151C</Color>
    <Color x:Key="VFMenuColor">#0D1118</Color>
    <Color x:Key="VFPanelColor">#151B22</Color>
    <Color x:Key="VFPanelAltColor">#1B222C</Color>
    <Color x:Key="VFEditorColor">#111820</Color>
    <Color x:Key="VFDockColor">#10161D</Color>
    <Color x:Key="VFBorderColor">#303947</Color>
    <Color x:Key="VFSoftBorderColor">#242D39</Color>
    <Color x:Key="VFAccentColor">#8B7CF6</Color>
    <Color x:Key="VFAccentBlueColor">#3BAFDA</Color>
    <Color x:Key="VFSuccessColor">#4EBC7B</Color>
    <Color x:Key="VFWarningColor">#D9A441</Color>
    <Color x:Key="VFDangerColor">#E06C75</Color>

    <SolidColorBrush x:Key="VFChromeBrush" Color="{StaticResource VFChromeColor}" />
    <SolidColorBrush x:Key="VFMenuBrush" Color="{StaticResource VFMenuColor}" />
    <SolidColorBrush x:Key="VFPanelBrush" Color="{StaticResource VFPanelColor}" />
    <SolidColorBrush x:Key="VFPanelAltBrush" Color="{StaticResource VFPanelAltColor}" />
    <SolidColorBrush x:Key="VFEditorBrush" Color="{StaticResource VFEditorColor}" />
    <SolidColorBrush x:Key="VFDockBrush" Color="{StaticResource VFDockColor}" />
    <SolidColorBrush x:Key="VFBorderBrush" Color="{StaticResource VFBorderColor}" />
    <SolidColorBrush x:Key="VFSoftBorderBrush" Color="{StaticResource VFSoftBorderColor}" />
    <SolidColorBrush x:Key="VFAccentBrush" Color="{StaticResource VFAccentColor}" />
    <SolidColorBrush x:Key="VFAccentBlueBrush" Color="{StaticResource VFAccentBlueColor}" />
    <SolidColorBrush x:Key="VFSuccessBrush" Color="{StaticResource VFSuccessColor}" />
    <SolidColorBrush x:Key="VFWarningBrush" Color="{StaticResource VFWarningColor}" />
    <SolidColorBrush x:Key="VFDangerBrush" Color="{StaticResource VFDangerColor}" />

    <Thickness x:Key="VFDockHeaderPadding">8,5</Thickness>

    <Style x:Key="VFPaneHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VFIconButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style x:Key="VFStatusTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VFDockTitleBarStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Background" Value="{StaticResource VFPanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VFBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="VFDockTitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="VFDockGlyphTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#8B98AA" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
